<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>OpenMagicMouse</AssemblyName>
    <RootNamespace>OpenMagicMouse</RootNamespace>
    <Version>2.2.0</Version>
    <Company>OpenMagicMouse Open Source</Company>
    <Product>OpenMagicMouse</Product>
    <Description>100% Open-Source Native Multi-Touch Engine &amp; Visualizer for Apple Magic Mouse 2 on Windows</Description>
  </PropertyGroup>

</Project>
